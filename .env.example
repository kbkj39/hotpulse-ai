# 数据库
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hotpulse
SPRING_DATASOURCE_USERNAME=hotpulse
SPRING_DATASOURCE_PASSWORD=hotpulse123
POSTGRES_USER=hotpulse
POSTGRES_PASSWORD=hotpulse123

# Redis
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=hotpulse
RABBITMQ_PASSWORD=hotpulse123

# AI 服务
SOPHNET_API_KEY=
SOPHNET_BASE_URL=https://www.sophnet.com/api/open-apis
SOPHNET_CHAT_COMPLETIONS_PATH=/chat/completions
SOPHNET_CHAT_MODEL=DeepSeek-v3

# RAG/Embedding（默认关闭，主链路不依赖）
HOTPULSE_RAG_ENABLED=false
EMBEDDING_MODEL=text-embedding-3-small

# Agent 并发控制
AGENT_SEARCHER_MAX_PARALLEL=5
AGENT_CRAWLER_MAX_PARALLEL=10
AGENT_TOKEN_BUDGET_PER_EXECUTION=50000

# 应用
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# 可观测性
OTEL_EXPORTER_OTLP_ENDPOINT=
